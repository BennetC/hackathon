# FDN START Hack 2026: environment template. Copy to .env and fill in. Never commit .env.

# --- QuantCo competition credentials (required) ---
TEAM_API_KEY=

# --- Model provider keys (set only what the strategy uses) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- claimbot ---
CLAIMBOT_BASE_URL=https://c2f.public.quantco.cloud
# Encrypted case_NNN.zip files, and run logs/reports.
CLAIMBOT_CASES_DIR=data/cases
CLAIMBOT_RUNS_DIR=runs
# Python format string for the zip of game N.
CLAIMBOT_CASE_FILE_TEMPLATE=case_{game_id:03d}.zip

# Pricing strategy: registered name ("council") or "module:Class".
# Every strategy subclasses claimbot.strategies.base.Strategy and returns a StrategyResult.
CLAIMBOT_STRATEGY=council

# Optional override for the Antigravity CLI/ACP binary (auto-detected if omitted).
# CLAIMBOT_ANTIGRAVITY_BIN=

# Timing (seconds).
CLAIMBOT_GAME_WINDOW_S=60
# Stop waiting for the strategy this long before the window closes.
CLAIMBOT_SUBMIT_MARGIN_S=8
# Keep retrying the key endpoint for this long after start_time (403 = not yet).
CLAIMBOT_KEY_RETRY_S=15
# Key polling: first request this long before start_time, then once per KEY_POLL_S
# (1 s: a 403 just means "not yet"; do not poll faster, avoid rate limits).
CLAIMBOT_KEY_EARLY_S=0.5
CLAIMBOT_KEY_POLL_S=1.0
# Listener wakes this long before start to re-check the schedule and warm up.
CLAIMBOT_WAKE_LEAD_S=10
# How often the listener refreshes the game schedule.
CLAIMBOT_SCHEDULE_REFRESH_S=120
CLAIMBOT_HTTP_TIMEOUT_S=8

# Fallback (a, b), sent for every parsed line as soon as the case is read and used
# for lines the strategy misses. Placeholder values: tune once the model exists.
CLAIMBOT_FALLBACK_CHARGE=0
CLAIMBOT_FALLBACK_LIMIT=200
# If the invoice parser finds no lines, submit indices 1..N blind (0 = off).
CLAIMBOT_FALLBACK_LINE_COUNT=0

# --- FDN Bench (Ruben's benchmark backend, uploaded automatically after submit_final) ---
CLAIMBOT_BENCH_URL=https://bench.159-195-78-137.sslip.io
# Set token to auto-enable upload (or toggle explicitly with CLAIMBOT_BENCH_UPLOAD=true|false).
CLAIMBOT_BENCH_TOKEN=
CLAIMBOT_BENCH_AUTHOR=fdn
# Optional strategy name override in FDN Bench (defaults to strategy.name, e.g. "council").
# CLAIMBOT_BENCH_STRATEGY_NAME=
# CLAIMBOT_BENCH_UPLOAD=true
